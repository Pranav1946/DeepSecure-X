# ==============================================================================
# DeepSecure-X Environment Configuration
# ==============================================================================

# Application Environment (development | production | staging)
ENVIRONMENT=production

# Database Connection URL
# SQLite default: sqlite+aiosqlite:///./deepsecure.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/deepsecure_db
DATABASE_URL=sqlite+aiosqlite:///./deepsecure.db
DB_ECHO=false

# Authentication & JWT Security (REQUIRED in production: generate a 64+ char random string)
SECRET_KEY=generate_a_strong_random_secret_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI API Configuration for AI Security Intelligence
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=25.0

# Allowed CORS Origins (comma-separated URLs for production frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.com

# Server Binding
HOST=0.0.0.0
PORT=8000

